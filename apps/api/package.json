{
  "name": "@gestion/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend NestJS del monorepo: Better Auth montado como handler, Drizzle sobre PostgreSQL y el contrato Zod de @gestion/shared.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/main.js",
    "test": "node --test --experimental-transform-types --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gestion/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "better-auth": "^1.3.26",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.10"
  }
}
